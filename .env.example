# ─── LLM ──────────────────────────────────────────────────────────────────────
# Clave API de Groq (gratuita): https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── API ───────────────────────────────────────────────────────────────────────
# Contraseña de acceso a la API (dejar vacío para deshabilitar autenticación)
CLIENT_API_KEY=cambia_esta_clave

# Puerto del servidor (el instalador setup.sh lo configura automáticamente)
API_PORT=8088

# ─── RED ───────────────────────────────────────────────────────────────────────
# Interfaz donde escucha uvicorn:
#   127.0.0.1 → solo accesible desde localhost (usar con nginx proxy)
#   0.0.0.0   → accesible desde cualquier IP (acceso directo, abrir puerto en firewall)
BIND_HOST=127.0.0.1

# URL pública donde los navegadores de los usuarios accederán al chatbot.
# Si usas nginx proxy:  PUBLIC_API_URL=https://tudominio.com/chatbot-api
# Si usas acceso directo: PUBLIC_API_URL=http://IP_SERVIDOR:8088
PUBLIC_API_URL=http://127.0.0.1:8088

# Origen CORS permitido (* = todos, o especificar dominio del cliente)
# Ejemplo en producción: APP_URL=https://tudominio.com
APP_URL=*
