# ─── LLM ──────────────────────────────────────────────────────────────────────
# Clave API de Groq (gratuita): https://console.groq.com
GROQ_API_KEY=gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── API ───────────────────────────────────────────────────────────────────────
# Contraseña de acceso a la API (dejar vacío para deshabilitar autenticación)
CLIENT_API_KEY=cambia_esta_clave

# Puerto del servidor (el instalador setup.sh lo configura automáticamente)
API_PORT=8088

# Origen CORS permitido (* = todos, o especificar dominio del cliente)
# Ejemplo en producción: APP_URL=https://tudominio.com
APP_URL=*
